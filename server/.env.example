PORT=4000
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-url>/pizzadelivery?retryWrites=true&w=majority
JWT_SECRET=change-me
SEED_DEMO_DATA=false
EMAIL_USER=yourgmail@gmail.com
EMAIL_APP_PASSWORD=your-16-character-google-app-password
# Recommended for Render Free: uses HTTPS instead of blocked Gmail SMTP.
# Create a free API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
# New Resend accounts can use onboarding@resend.dev for their own verified inbox.
# Verify a domain in Resend before using a custom sender address.
EMAIL_FROM=PizzaFlow <onboarding@resend.dev>
CLIENT_URL=http://localhost:5173
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Production notes:
# CLIENT_URL can contain multiple frontend URLs separated by commas.
# Example: CLIENT_URL=https://your-site.vercel.app,https://your-preview.vercel.app
